# ===== 서버 설정 =====
PORT=3000
NODE_ENV=development

# ===== PostgreSQL 데이터베이스 연결 =====
# Render: PostgreSQL 연결 시 DATABASE_URL이 자동 주입됩니다.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DB_HOST=localhost
DB_PORT=5432
DB_NAME=metadata_db
DB_USER=postgres
DB_PASSWORD=your_password_here
# Render 등 외부 DB 사용 시 SSL 필요하면 true (DATABASE_URL 사용 시 render.com이면 자동 적용)
DB_SSL=false

# 연결 풀 설정
DB_POOL_MIN=2
DB_POOL_MAX=10

# ===== Google AI (Gemini) - 용어 설명 자동 생성 =====
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
GOOGLE_AI_MODEL=gemini-2.5-flash
