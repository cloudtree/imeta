# ===== 서버 설정 =====
PORT=3000
NODE_ENV=development

# ===== PostgreSQL =====
# Render: Web Service에 PostgreSQL Link → DATABASE_URL 자동 설정 (권장)
# 수동 설정 시 DB_NAME=imetadb, DB_USER=imetadb_user (서로 다름!)
DB_HOST=dpg-d93k4ataeets73dt1jb0-a.singapore-postgres.render.com
DB_PORT=5432
DB_NAME=imetadb
DB_USER=imetadb_user
DB_PASSWORD=your_password_here
DB_SSL=true

DB_POOL_MIN=2
DB_POOL_MAX=10

# ===== Google AI (Gemini) =====
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
GOOGLE_AI_MODEL=gemini-2.5-flash
