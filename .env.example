# ===== 서버 설정 =====
PORT=3000
NODE_ENV=development

# ===== PostgreSQL =====
# Render: Web Service에 PostgreSQL Link → DATABASE_URL 자동 설정 (권장)
# 수동 설정 시 DB_NAME=imetadb, DB_USER=imetadb_user (서로 다름!)
DB_HOST=dpg-d93k4ataeets73dt1jb0-a.singapore-postgres.render.com
DB_PORT=5432
DB_NAME=imetadb
DB_USER=imetadb_user
DB_PASSWORD=your_password_here
DB_SSL=true

DB_POOL_MIN=2
DB_POOL_MAX=10

# ===== CORS (프론트 배포 URL, 쉼표로 여러 개 가능) =====
# CORS_ORIGIN=https://imeta-ui.onrender.com

# ===== 로그인 =====
AUTH_USERNAME=cloudtree
