# ===== 서버 설정 =====
PORT=3000
NODE_ENV=development

# ===== PostgreSQL =====
# Render: Web Service에 PostgreSQL Link → DATABASE_URL 자동 설정 (권장)
# 수동 설정 시 DB_NAME=imetadb, DB_USER=imetadb_user (서로 다름!)
DB_HOST=dpg-d93k4ataeets73dt1jb0-a.singapore-postgres.render.com
DB_PORT=5432
DB_NAME=imetadb
DB_USER=imetadb_user
DB_PASSWORD=your_password_here
DB_SSL=true

DB_POOL_MIN=2
DB_POOL_MAX=10

# ===== CORS (프론트 배포 URL, 쉼표로 여러 개 가능) =====
# CORS_ORIGIN=https://imeta-ui.onrender.com

# ===== 로그인 =====
AUTH_USERNAME=cloudtree
AUTH_PASSWORD=americano
# AUTH_SECRET=change-this-in-production

# ===== 네이버 영어사전 (단어 등록 시 영문명 자동조회) =====
# 폐쇄망 등 외부 인터넷 접근이 없는 환경에서는 false로 설정 — 호출을 시도하지 않고 조용히 건너뜀
# NAVER_DICT_ENABLED=false
