# ===== 서버 설정 =====
PORT=3000
NODE_ENV=development

# ===== PostgreSQL 데이터베이스 연결 =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=metadata_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# 연결 풀 설정
DB_POOL_MIN=2
DB_POOL_MAX=10

# ===== Google AI (Gemini) - 용어 설명 자동 생성 =====
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
GOOGLE_AI_MODEL=gemini-2.5-flash
